# Production env for docker-compose.prod.yml. The deploy workflow generates this
# on the server from GitHub Actions secrets — copy here only for manual runs.

# Container image prefix (GitHub Container Registry namespace).
IMAGE_PREFIX=ghcr.io/your-github-username

# Postgres (shared by both apps; the app user is the DB owner/superuser).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-long-random

# teamly
AUTH_SECRET=change-me-32+chars-random

# agent-os (all optional; without keys it falls back to offline adapters)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
TAVILY_API_KEY=
ALLOWLIST_DOMAINS=api.github.com

# Domains + TLS (point A records at the server first)
TEAMLY_DOMAIN=teamly.work8n.ru
AGENT_DOMAIN=agent.work8n.ru
ACME_EMAIL=you@work8n.ru

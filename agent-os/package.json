{
  "name": "agent-os",
  "version": "0.1.0",
  "description": "Runnable MVP scaffold of a multi-tenant AI agent runtime (control / execution / data planes).",
  "license": "ISC",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "jest -c jest.integration.config.js",
    "start": "ts-node src/main.ts",
    "dev:coordinator": "ts-node src/dev.ts",
    "worker": "ts-node src/worker/worker.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}

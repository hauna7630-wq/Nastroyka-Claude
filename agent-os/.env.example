# --- Data plane (production) ---
DATABASE_URL="postgresql://user:pass@localhost:5432/agent_os?schema=public"

# --- Execution plane (production) ---
REDIS_URL="redis://localhost:6379"

# --- Model provider (production) ---
# Latest Claude models: claude-opus-4-8 (most capable), claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Tool sandbox ---
# Comma-separated allowlist for the http_request tool. Deny-by-default: empty = no egress.
ALLOWLIST_DOMAINS="api.github.com,example.com"

# Per-tool-call limits (advisory in MVP; enforced by sandbox in production).
TOOL_CPU_MS="5000"
TOOL_MEM_MB="256"

# --- Control-plane HTTP server ---
PORT="3000"

# --- Data plane (production) ---
DATABASE_URL="postgresql://user:pass@localhost:5432/agent_os?schema=public"

# --- Execution plane (production) ---
REDIS_URL="redis://localhost:6379"

# --- Model provider (production) ---
# Latest Claude models: claude-opus-4-8 (most capable), claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Integration tools (PRD §3) ---
# Web search providers for the agent-os web_search tool (tool/API path).
# Cascade: Perplexity (preferred) → Tavily. Both empty = web_search tool disabled
# (the subscription/CLI path still uses the CLI's built-in WebSearch).
TAVILY_API_KEY=""
PERPLEXITY_API_KEY=""

# Allow the Claude CLI's built-in WebSearch/WebFetch for search-capable agents on
# the subscription path. Default on; set to 0 to disable fleet-wide.
CLAUDE_CLI_WEB_SEARCH="1"

# --- Tool sandbox ---
# Comma-separated allowlist for the http_request tool. Deny-by-default: empty = no egress.
ALLOWLIST_DOMAINS="api.github.com,example.com"

# Per-tool-call limits (advisory in MVP; enforced by sandbox in production).
TOOL_CPU_MS="5000"
TOOL_MEM_MB="256"

# --- Control-plane HTTP server ---
PORT="3000"
